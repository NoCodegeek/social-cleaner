{
  "manifest_version": 3,
  "name": "Social Cleaner",
  "version": "2.1.0",
  "description": "Bulk-unfollow pages and profiles and leave old groups on Facebook — scan, filter by category or keyword, and clean up your feed.",
  "author": "NoCodeGeek (https://github.com/NoCodegeek)",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Social Cleaner",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://www.instagram.com/*",
        "https://twitter.com/*",
        "https://x.com/*"
      ],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "sidePanel"
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://www.instagram.com/*",
    "https://twitter.com/*",
    "https://x.com/*",
    "https://raw.githubusercontent.com/*"
  ]
}
